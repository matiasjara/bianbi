# Acceso privado a Bianbi (todo excepto /c/* landings)
AUTH_PASSWORD=cambia-esta-contraseña
AUTH_SECRET=genera-un-string-largo-aleatorio

# Firebase (proyecto bianbi-cl)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bianbi-cl
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bianbi-cl.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bianbi-cl.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (servidor — descargar JSON en Console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=bianbi-cl
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
